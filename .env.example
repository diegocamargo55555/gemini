# Porta de exposição pública da aplicação
PORT=8080

# Credenciais do PostgreSQL
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_secret_pass_123
POSTGRES_DB=portfolio_db

# String de Conexão com o Banco de Dados (usada internamente ou em dev local)
DATABASE_URL=postgres://portfolio_user:portfolio_secret_pass_123@localhost:5432/portfolio_db?sslmode=disable

# Caminho do arquivo de definição de projetos
PROJECTS_FILE=data/projects.yaml

# Diretório dos arquivos estáticos compilados do React
STATIC_DIR=frontend/dist

# Ativar Hot-Reload de projetos ao alterar data/projects.yaml (true/false)
ENABLE_HOT_RELOAD=true
